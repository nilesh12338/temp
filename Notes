    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script>
        $(document).ready(function () {
            
            // ==========================================
            // 1. DATA RENDERING ENGINE (Dropdowns)
            // ==========================================
            function renderDropdownData($wrapper, data) {
                let html = '';
                data.forEach(group => {
                    const displayStyle = group.isCollapsedByDefault ? 'style="display: none;"' : '';
                    const iconClass = group.isCollapsedByDefault ? 'bi-plus-circle-fill' : 'bi-dash-circle-fill';
                    const groupValAttr = group.groupValue ? `value="${group.groupValue}"` : '';

                    html += `<div class="group-container" data-group-name="${group.groupName}" data-group-value="${group.groupValue}"><div class="group-header"><label><input type="checkbox" class="form-check-input group-checkbox" ${groupValAttr}><span>All ${group.groupName}</span></label><i class="bi ${iconClass} collapse-toggle"></i></div><ul class="group-items" ${displayStyle}>`;
                    if (group.subGroups && group.subGroups.length > 0) {
                        group.subGroups.forEach(sub => {
                            html += `<li class="subgroup-container pt-2 pb-1 border-bottom"><label class="fw-bold text-dark ms-3 d-flex align-items-center gap-2" style="font-size: 0.85rem; cursor: pointer;"><input type="checkbox" class="form-check-input subgroup-checkbox">${sub.subGroupName}</label><ul class="list-unstyled ms-4 mt-1 mb-2">`;
                            sub.items.forEach(item => { html += `<li class="flat-item"><label><input type="checkbox" class="form-check-input item-checkbox" value="${item.value}">${item.label}</label></li>`; });
                            html += `</ul></li>`;
                        });
                    } else if (group.items) {
                        group.items.forEach(item => { html += `<li class="flat-item"><label><input type="checkbox" class="form-check-input item-checkbox" value="${item.value}">${item.label}</label></li>`; });
                    }
                    html += `</ul></div>`;
                });
                $wrapper.find('.dynamic-container').html(html);
                $wrapper.find('.trigger-btn').prop('disabled', false);
                updateSelectedDisplayText($wrapper);
            }

            // ==========================================
            // 2. MOCK API - INITIALIZATION
            // ==========================================
            function fetchBusinessGroups() {
                renderDropdownData($('#dd-business-group'), [{ groupName: "Leads", isCollapsedByDefault: false, items: [{ value: "DEF", label: "DEF" }] }]);
            }

            function fetchActivities() {
                const mockApiResponse = [
                    { groupName: "PROPOSALS", groupValue: "proposals", isCollapsedByDefault: false, items: [ { value: "DD", label: "DD" }, { value: "DDS", label: "DDS" }, { value: "PABL", label: "PABL" }, { value: "BREDDSPDM", label: "BRE DDSPDM" }, { value: "BRECAFPDM", label: "BRE CAFPDM" } ] },
                    { groupName: "CONTROL REPORT", groupValue: "control_report", isCollapsedByDefault: true, items: [ { value: "CR_CLP", label: "CLP" }, { value: "CR_RM", label: "RM" } ] },
                    { groupName: "POST SANCTION", groupValue: "post_sanction", isCollapsedByDefault: true, items: [ { value: "StockStatements", label: "Stock Statements" }, { value: "InspectionReports", label: "Inspection Reports" } ] },
                    { groupName: "CBS", groupValue: "cbs", isCollapsedByDefault: true, subGroups: [ { subGroupName: "Account Opening", items: [{ value: "DLTC", label: "DLTC" }, { value: "CCOD", label: "CCOD" }, { value: "Contingent", label: "Contingent" }] } ] },
                    { groupName: "CRA", groupValue: "cra", isCollapsedByDefault: true, items: [ { value: "CRA_CLP", label: "CLP" }, { value: "CRA_RM", label: "RM" } ] },
                    { groupName: "LRM", groupValue: "lrm", isCollapsedByDefault: true, items: [ { value: "LRM_1", label: "LRM Check 1" } ] },
                    { groupName: "MEETING", groupValue: "meeting", isCollapsedByDefault: true, items: [ { value: "MEET_DD", label: "DD" }, { value: "MEET_PABL", label: "PABL" } ] },
                    { groupName: "LEAD", groupValue: "lead", isCollapsedByDefault: true, items: [ { value: "LEAD_CLP", label: "CLP" }, { value: "LEAD_IBG", label: "IBG" } ] }
                ];
                renderDropdownData($('#dd-activity'), mockApiResponse);
            }
            fetchBusinessGroups(); fetchActivities();

            // ==========================================
            // 3. UI DROPDOWN BEHAVIORS
            // ==========================================
            function updateSelectedDisplayText($wrapper) {
                const checked = []; $wrapper.find('.item-checkbox:checked').each(function () { checked.push($(this).parent().text().trim()); });
                const $txt = $wrapper.find('.selected-text');
                if (checked.length === 0) $txt.text('Select options'); else if (checked.length <= 2) $txt.text(checked.join(', ')); else $txt.text(checked.slice(0, 2).join(', ') + `, +${checked.length - 2} more`);
            }
            function syncMainGroupCheckbox($container) {
                const total = $container.find('.item-checkbox').length, checked = $container.find('.item-checkbox:checked').length;
                $container.find('.group-checkbox').prop('checked', total === checked && total > 0);
            }

            $(document).on('click', '.trigger-btn', function (e) { e.stopPropagation(); const $menu = $(this).siblings('.custom-multiselect-menu'); $('.custom-multiselect-menu').not($menu).removeClass('show'); $menu.toggleClass('show'); });
            $(document).on('click', '.close-dropdown-btn', function () { $(this).closest('.custom-multiselect-menu').removeClass('show'); });
            $(document).on('click', function (e) { if (!$(e.target).closest('.dropdown-wrapper').length) $('.custom-multiselect-menu').removeClass('show'); });
            $(document).on('click', '.collapse-toggle', function (e) { e.stopPropagation(); const $list = $(this).closest('.group-container').find('.group-items'); $list.slideToggle(150, () => { $(this).toggleClass('bi-plus-circle-fill bi-dash-circle-fill'); }); });
            $(document).on('click', '.btn-check-all', function () { $(this).closest('.dropdown-wrapper').find('input[type="checkbox"]').prop('checked', true); updateSelectedDisplayText($(this).closest('.dropdown-wrapper')); });
            $(document).on('click', '.btn-uncheck-all', function () { $(this).closest('.dropdown-wrapper').find('input[type="checkbox"]').prop('checked', false); updateSelectedDisplayText($(this).closest('.dropdown-wrapper')); });
            $(document).on('change', '.group-checkbox', function () { $(this).closest('.group-container').find('.item-checkbox, .subgroup-checkbox').prop('checked', $(this).is(':checked')); updateSelectedDisplayText($(this).closest('.dropdown-wrapper')); });
            $(document).on('change', '.subgroup-checkbox', function () { $(this).closest('.subgroup-container').find('.item-checkbox').prop('checked', $(this).is(':checked')); syncMainGroupCheckbox($(this).closest('.group-container')); updateSelectedDisplayText($(this).closest('.dropdown-wrapper')); });
            $(document).on('change', '.item-checkbox', function () { const $sub = $(this).closest('.subgroup-container'); if ($sub.length) { const tot = $sub.find('.item-checkbox').length, chk = $sub.find('.item-checkbox:checked').length; $sub.find('.subgroup-checkbox').prop('checked', tot === chk && tot > 0); } syncMainGroupCheckbox($(this).closest('.group-container')); updateSelectedDisplayText($(this).closest('.dropdown-wrapper')); });


            // ==========================================
            // 4. THEMES & SERVER JSON DATA (STATIC)
            // ==========================================
            const formatNumber = (num) => (num !== undefined && num !== null) ? num.toLocaleString('en-IN') : '-';

            const cardThemes = {
                "proposals": { themeClass: "theme-blue", baseColor: "theme-blue", icon: "bi-file-earmark-text-fill", hasAmount: true, tabs: ["Created", "Approved"] },
                "control_report": { themeClass: "theme-purple", baseColor: "theme-purple", icon: "bi-file-earmark-bar-graph-fill", hasAmount: true, tabs: ["Created", "Approved"] },
                "post_sanction": { themeClass: "theme-green", baseColor: "theme-green", icon: "bi-check-square-fill", hasAmount: true, tabs: ["Created", "Approved"] },
                "cbs": { themeClass: "theme-cbs", baseColor: "theme-cbs", icon: "bi-bank2", hasAmount: true, tabs: ["Initiated", "Completed"] },
                "cra": { themeClass: "theme-teal", baseColor: "theme-teal", icon: "bi-pie-chart-fill", hasAmount: true, tabs: ["Created", "Approved"] },
                "lrm": { themeClass: "theme-yellow", baseColor: "theme-yellow", icon: "bi-journal-text", hasAmount: true, tabs: ["Created", "Approved"] },
                "meeting": { themeClass: "theme-red", baseColor: "theme-red", icon: "bi-camera-video-fill", hasAmount: true, tabs: ["Created", "Approved"] },
                "lead": { themeClass: "theme-indigo", baseColor: "theme-indigo", icon: "bi-person-lines-fill", hasAmount: false, tabs: ["Total Created", "Approved"] }
            };

            // STATIC JSON OBJECT: Simulates data fetched from the server.
            // Keys correspond to the "value" of the multiselect checkboxes.
            const serverStatsData = {
