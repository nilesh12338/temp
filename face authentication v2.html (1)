<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Enterprise Face Authentication - Professional View</title>
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- jQuery CDN -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <style>
        :root {
            --primary-accent: #0284c7;
            --primary-glow: rgba(2, 132, 199, 0.35);
            --card-bg: rgba(15, 23, 42, 0.94);
            --border-color: rgba(255, 255, 255, 0.12);
        }

        body {
            background-color: #f8fafc;
            color: #1e293b;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            overflow-x: hidden;
        }

        /* Mock Corporate Portal Layout */
        .portal-navbar {
            background: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            padding: 0.85rem 2rem;
        }

        .portal-logo {
            font-weight: 700;
            font-size: 1.1rem;
            color: #0f172a;
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .portal-badge {
            font-size: 0.75rem;
            background: #e0f2fe;
            color: #0369a1;
            padding: 2px 8px;
            border-radius: 6px;
            font-weight: 600;
        }

        .dashboard-content {
            padding: 2.5rem 0;
        }

        .analytics-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 1.75rem;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
        }

        /* =========================================================================
           PROFESSIONAL FACE AUTH PROMOTION CARD
           ========================================================================= */
        .face-auth-pro-card {
            position: fixed;
            top: 55%;
            right: -420px; /* Offscreen initially */
            z-index: 10000;
            width: 270px;
            background: var(--card-bg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            box-shadow: 0 20px 40px -15px rgba(15, 23, 42, 0.6),
                        0 0 0 1px rgba(255, 255, 255, 0.05),
                        0 8px 24px -4px var(--primary-glow);
            cursor: pointer;
            overflow: hidden;
            transition: right 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.25s ease, box-shadow 0.25s ease;
        }

        .face-auth-pro-card.slide-active {
            right: 24px;
        }

        .face-auth-pro-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 24px 48px -12px rgba(15, 23, 42, 0.7), 0 0 28px rgba(2, 132, 199, 0.45);
        }

        /* --- Slanted Glowing "NEW" Ribbon --- */
        .ribbon-wrapper {
            position: absolute;
            top: 0;
            left: 0;
            width: 85px;
            height: 85px;
            overflow: hidden;
            pointer-events: none;
            z-index: 10;
        }

        .ribbon-slant {
            position: absolute;
            top: 15px;
            left: -28px;
            transform: rotate(-45deg);
            width: 100px;
            background: linear-gradient(135deg, #f43f5e, #e11d48);
            color: #ffffff;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-align: center;
            line-height: 20px;
            text-transform: uppercase;
            box-shadow: 0 2px 8px rgba(244, 63, 94, 0.4);
            animation: ribbon-pulse 1.8s ease-in-out infinite alternate;
        }

        @keyframes ribbon-pulse {
            0% {
                opacity: 1;
                filter: brightness(1);
            }
            100% {
                opacity: 0.35;
                filter: brightness(1.2);
            }
        }

        /* --- Minimal Enterprise Close Button --- */
        .pro-close-btn {
            position: absolute;
            top: 10px;
            right: 12px;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            width: 26px;
            height: 26px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #94a3b8;
            font-size: 15px;
            cursor: pointer;
            z-index: 10;
            transition: all 0.2s ease;
        }

        .pro-close-btn:hover {
            background: rgba(244, 63, 94, 0.2);
            color: #fda4af;
            border-color: rgba(244, 63, 94, 0.3);
            transform: rotate(90deg);
        }

        /* --- Card Content Body --- */
        .pro-card-body {
            padding: 28px 20px 20px 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            position: relative;
            z-index: 2;
        }

        /* --- Biometric Face Scanner Stage --- */
        .biometric-stage {
            position: relative;
            width: 86px;
            height: 86px;
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .biometric-svg {
            width: 100%;
            height: 100%;
            overflow: visible;
        }

        /* Target Reticle Corners */
        .reticle-corner {
            stroke: #38bdf8;
            stroke-width: 2;
            stroke-linecap: round;
        }

        /* Pulsing Sonar Ring */
        .sonar-circle {
            fill: none;
            stroke: #0ea5e9;
            stroke-width: 1.5;
            opacity: 0.2;
            transform-origin: center;
            animation: sonar-radar 3s linear infinite;
        }

        @keyframes sonar-radar {
            0%   { r: 24; opacity: 0.5; }
            100% { r: 40; opacity: 0; }
        }

        /* Precision Scanning Laser Line */
        .scanner-beam {
            position: absolute;
            left: 10%;
            width: 80%;
            height: 2px;
            background: linear-gradient(90deg, transparent, #38bdf8, #818cf8, transparent);
            box-shadow: 0 0 10px #38bdf8, 0 0 18px #6366f1;
            border-radius: 50%;
            animation: beam-scan 2.4s ease-in-out infinite alternate;
        }

        @keyframes beam-scan {
            0%   { top: 12%; opacity: 0.3; }
            50%  { opacity: 1; }
            100% { top: 88%; opacity: 0.3; }
        }

        /* --- Infinite Periodic Flower Blast Animation --- */
        .flower-blast-orchestrator {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 1px;
            height: 1px;
            pointer-events: none;
            z-index: 1;
        }

        /* 8 Petal Shapes Dispersing in a 6-Second Infinite Loop */
        .petal {
            position: absolute;
            top: 0;
            left: 0;
            width: 12px;
            height: 22px;
            border-radius: 50% 50% 50% 50% / 80% 80% 20% 20%;
            opacity: 0;
            pointer-events: none;
            transform-origin: bottom center;
            animation: flower-bloom-cycle 6s ease-out infinite;
        }

        /* Flower Petal Palette: Refined Cyan, Violet & Rosé Accents */
        .p1 { --deg: 0deg;   --dist: 60px; background: linear-gradient(to top, #38bdf8, #818cf8); }
        .p2 { --deg: 45deg;  --dist: 65px; background: linear-gradient(to top, #818cf8, #c084fc); }
        .p3 { --deg: 90deg;  --dist: 60px; background: linear-gradient(to top, #f43f5e, #fb7185); }
        .p4 { --deg: 135deg; --dist: 65px; background: linear-gradient(to top, #fb7185, #f472b6); }
        .p5 { --deg: 180deg; --dist: 60px; background: linear-gradient(to top, #38bdf8, #0ea5e9); }
        .p6 { --deg: 225deg; --dist: 65px; background: linear-gradient(to top, #c084fc, #818cf8); }
        .p7 { --deg: 270deg; --dist: 60px; background: linear-gradient(to top, #f43f5e, #fda4af); }
        .p8 { --deg: 315deg; --dist: 65px; background: linear-gradient(to top, #38bdf8, #67e8f9); }

        /* Animation timeline: Silent pause for 4.2s, then sudden bloom blast for 1.8s */
        @keyframes flower-bloom-cycle {
            0%, 70% {
                opacity: 0;
                transform: rotate(var(--deg)) translateY(0) scale(0.2);
            }
            72% {
                opacity: 0.95;
                transform: rotate(var(--deg)) translateY(0) scale(0.6);
            }
            88% {
                opacity: 0.8;
                transform: rotate(var(--deg)) translateY(calc(-1 * var(--dist))) scale(1.1);
            }
            100% {
                opacity: 0;
                transform: rotate(var(--deg)) translateY(calc(-1 * var(--dist) - 15px)) scale(0.4);
            }
        }

        /* Core Bloom Shockwave Flare */
        .flower-core-glow {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(56, 189, 248, 0.9) 0%, rgba(129, 140, 248, 0.4) 40%, transparent 70%);
            opacity: 0;
            pointer-events: none;
            animation: core-flare-cycle 6s ease-out infinite;
        }

        @keyframes core-flare-cycle {
            0%, 70% {
                width: 10px;
                height: 10px;
                opacity: 0;
            }
            74% {
                width: 90px;
                height: 90px;
                opacity: 0.85;
            }
            85% {
                width: 160px;
                height: 160px;
                opacity: 0;
            }
            100% {
                opacity: 0;
            }
        }

        /* --- Typography & Action CTA --- */
        .pro-auth-title {
            color: #f8fafc;
            font-size: 15px;
            font-weight: 600;
            letter-spacing: -0.2px;
            margin: 0;
        }

        .pro-auth-tagline {
            font-size: 11px;
            color: #94a3b8;
            margin: 4px 0 14px 0;
            letter-spacing: 0.1px;
        }

        .pro-auth-btn {
            background: linear-gradient(135deg, #0284c7, #2563eb);
            color: #ffffff;
            font-size: 12px;
            font-weight: 600;
            padding: 6px 14px;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border: 1px solid rgba(255, 255, 255, 0.15);
            transition: all 0.2s ease;
            box-shadow: 0 4px 12px rgba(2, 132, 199, 0.3);
        }

        .face-auth-pro-card:hover .pro-auth-btn {
            background: linear-gradient(135deg, #0369a1, #1d4ed8);
            box-shadow: 0 4px 16px rgba(2, 132, 199, 0.5);
            gap: 9px;
        }
    </style>
</head>
<body>

    <!-- Professional Portal Navigation Bar -->
    <header class="portal-navbar d-flex justify-content-between align-items-center">
        <div class="portal-logo">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            OmniSecure Enterprise Portal
            <span class="portal-badge">v3.4 Production</span>
        </div>
        <div>
            <button id="btnResetSession" class="btn btn-outline-secondary btn-sm" title="Clears sessionStorage flag and reloads">
                ↻ Reset Session & Re-run Promo
            </button>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="container-fluid dashboard-content">
        <div class="row g-4 px-md-4">
            <!-- Left & Core Workspace -->
            <div class="col-lg-9 col-md-8">
                <div class="analytics-card">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0">System Overview & Security Protocols</h5>
                        <span class="badge bg-success-subtle text-success border border-success-subtle">All Services Active</span>
                    </div>
                    <p class="text-secondary small">
                        This environment demonstrates the high-end, professional iteration of the <strong>Face Authentication</strong> promotional feature module. 
                        It follows enterprise visual guidelines with glassmorphism styling, a clean precision biometric scan wireframe, and an elegant periodic flower blossom burst animation.
                    </p>
                    
                    <div class="p-3 bg-light rounded-3 border mt-3">
                        <h6 class="fw-semibold small mb-1">Functional Architecture Checklist:</h6>
                        <ul class="small text-muted mb-0 ps-3">
                            <li><strong>Professional Biometric Visual:</strong> Mathematical facial nodes, precise target bracket reticles, and scanning laser sweep.</li>
                            <li><strong>Flower Blast Loop:</strong> An 8-petal geometric burst occurring periodically in an infinite loop without page performance lag.</li>
                            <li><strong>Slanted "NEW" Badge:</strong> Precision top-left 45-degree ribbon with subtle luminosity pulsation.</li>
                            <li><strong>State Persistence:</strong> Closing the widget triggers a smooth right-slide dismissal and sets a <code>sessionStorage</code> key so it remains hidden for the remainder of the session.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Right Column Target (.rghtCol) -->
            <div class="col-lg-3 col-md-4 rghtCol">
                <div class="analytics-card text-center">
                    <span class="text-uppercase text-secondary fw-bold" style="font-size: 11px; letter-spacing: 0.5px;">Right Container (.rghtCol)</span>
                    <p class="small text-muted mt-2 mb-0">The floating widget anchors alongside this column at the screen edge.</p>
                </div>
            </div>
        </div>
    </main>

    <!-- Script Implementation -->
    <script>
        /**
         * Initialize Face Authentication Promotion Widget (Professional View)
         * @param {string} destinationUrl - The target landing page URL
         */
        function initProfessionalFaceAuthPromo(destinationUrl) {
            // Check session storage flag
            if (sessionStorage.getItem("face_auth_promo_dismissed") === "true") {
                console.info("[Promo] Face Authentication widget dismissed for this active session.");
                return;
            }

            var targetUrl = destinationUrl || "/security/face-authentication";

            var widgetHtml = `
                <aside class="face-auth-pro-card" id="proFaceAuthWidget" title="Set up Biometric Face Authentication">
                    <!-- Slanted "NEW" Ribbon Badge -->
                    <div class="ribbon-wrapper">
                        <div class="ribbon-slant">NEW</div>
                    </div>

                    <!-- Clean Minimal Close Button -->
                    <button type="button" class="pro-close-btn" id="proFaceAuthClose" aria-label="Dismiss notification">&times;</button>

                    <!-- Flower Blossom Blast Container (Infinite Loop) -->
                    <div class="flower-blast-orchestrator">
                        <div class="flower-core-glow"></div>
                        <span class="petal p1"></span>
                        <span class="petal p2"></span>
                        <span class="petal p3"></span>
                        <span class="petal p4"></span>
                        <span class="petal p5"></span>
                        <span class="petal p6"></span>
                        <span class="petal p7"></span>
                        <span class="petal p8"></span>
                    </div>

                    <!-- Card Body -->
                    <div class="pro-card-body">
                        <!-- High-Tech Biometric Graphic -->
                        <div class="biometric-stage">
                            <!-- Laser Beam -->
                            <div class="scanner-beam"></div>

                            <svg class="biometric-svg" viewBox="0 0 80 80">
                                <!-- Reticle Corner Brackets -->
                                <path class="reticle-corner" d="M 6 20 V 6 H 20" />
                                <path class="reticle-corner" d="M 60 6 H 74 V 20" />
                                <path class="reticle-corner" d="M 6 60 V 74 H 20" />
                                <path class="reticle-corner" d="M 60 74 H 74 V 60" />

                                <!-- Sonar Radar Wave -->
                                <circle class="sonar-circle" cx="40" cy="40" r="26" />

                                <!-- Professional Minimal Face Silhouette -->
                                <path d="M 28 32 C 28 22 52 22 52 32 C 52 42 47 52 40 52 C 33 52 28 42 28 32 Z" 
                                      fill="none" stroke="rgba(148, 163, 184, 0.45)" stroke-width="1.6" stroke-dasharray="3 2" />

                                <!-- Biometric Nodes (Eyes, Nose, Chin) -->
                                <circle cx="35" cy="32" r="2" fill="#38bdf8" />
                                <circle cx="45" cy="32" r="2" fill="#38bdf8" />
                                <circle cx="40" cy="40" r="1.8" fill="#818cf8" />
                                <circle cx="40" cy="47" r="2" fill="#38bdf8" />

                                <!-- Crosshairs Axis Indicator -->
                                <line x1="38" y1="20" x2="42" y2="20" stroke="#38bdf8" stroke-width="1" />
                                <line x1="40" y1="18" x2="40" y2="22" stroke="#38bdf8" stroke-width="1" />
                            </svg>
                        </div>

                        <!-- Labels & CTA -->
                        <h6 class="pro-auth-title">Face Authentication</h6>
                        <p class="pro-auth-tagline">Faster, passwordless sign-in</p>
                        <span class="pro-auth-btn">
                            Enable Now
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M5 12h14M12 5l7 7-7 7"/>
                            </svg>
                        </span>
                    </div>
                </aside>
            `;

            // Append to .rghtCol or fallback to body
            var $targetContainer = $(".rghtCol").length ? $(".rghtCol") : $("body");
            $targetContainer.append(widgetHtml);

            var $card = $("#proFaceAuthWidget");

            // Trigger Smooth Slide-in
            setTimeout(function () {
                $card.addClass("slide-active");
            }, 350);

            // Handle Close: Slide back right, record session flag, remove from DOM
            $("#proFaceAuthClose").on("click", function (event) {
                event.stopPropagation(); // Stop card click
                sessionStorage.setItem("face_auth_promo_dismissed", "true");

                $card.removeClass("slide-active");
                setTimeout(function () {
                    $card.remove();
                }, 750);
            });

            // Card click: Navigate to the destination page
            $card.on("click", function () {
                alert("Redirecting to: " + targetUrl);
                window.location.href = targetUrl;
            });
        }

        // Initialize on DOM Ready
        $(document).ready(function () {
            initProfessionalFaceAuthPromo("/identity/face-auth-setup.html");

            // Helper button to clear sessionStorage for demo/testing
            $("#btnResetSession").on("click", function () {
                sessionStorage.removeItem("face_auth_promo_dismissed");
                location.reload();
            });
        });
    </script>
</body>
</html>
