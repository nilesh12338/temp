                "MEET_PABL": { tab1: { count: 1200, amount: 141405 }, tab2: { count: 1460, amount: 155000 } },
                
                // LEAD (No Amount Example)
                "LEAD_CLP": { tab1: { count: 1400, amount: 0 }, tab2: { count: 1500, amount: 0 } },
                "LEAD_IBG": { tab1: { count: 1000, amount: 0 }, tab2: { count: 1060, amount: 0 } },
                
                // DEFAULT FALLBACK
                "default": { tab1: { count: 0, amount: 0 }, tab2: { count: 0, amount: 0 } }
            };


            // ==========================================
            // 5. GLOBAL SEARCH HIGHLIGHT LOGIC
            // ==========================================
            function applySearchHighlight() {
                const searchTerm = $('#globalSearch').val().toLowerCase().trim();
                
                // Clear existing highlights
                $('.dash-table tbody tr').removeClass('highlight-row');
                
                if (searchTerm === '') {
                    $('.detail-card-wrapper').fadeIn(200);
                    return;
                }

                $('.detail-card-wrapper').each(function() {
                    let cardHasMatch = false;

                    $(this).find('.dash-table tbody tr').each(function() {
                        if ($(this).hasClass('no-search') || $(this).hasClass('subgroup-subtotal')) return;
                        
                        const rowText = $(this).text().toLowerCase();
                        if (rowText.includes(searchTerm)) {
                            $(this).addClass('highlight-row');
                            cardHasMatch = true;
                        }
                    });

                    // Hide or show the entire card based on match
                    if (cardHasMatch) {
                        $(this).fadeIn(200);
                    } else {
                        $(this).hide();
                    }
                });
            }

            $('#btnSearch').on('click', function() { applySearchHighlight(); });
            $('#globalSearch').on('keypress', function(e) { if (e.which === 13) applySearchHighlight(); });
            $('#btnClearSearch').on('click', function() {
                $('#globalSearch').val('');
                applySearchHighlight(); 
            });


            // ==========================================
            // 6. RENDER TABLE DETAILS (Tabs Logic)
            // ==========================================
            function renderCardTable($card, statusTab) {
                const groupVal = $card.data('groupVal');
                const isSubgrouped = $card.data('isSubgrouped');
                const themeConfig = cardThemes[groupVal];

                let theadHtml = `<tr><th>Module / Source</th>`;
                let colSpan = 2; 

                if (statusTab === 'tab3') {
                    theadHtml += `<th>${themeConfig.tabs[0]}<br><small>Count</small></th>`;
                    if (themeConfig.hasAmount) theadHtml += `<th>${themeConfig.tabs[0]}<br><small>Amount</small></th>`;
                    theadHtml += `<th>${themeConfig.tabs[1]}<br><small>Count</small></th>`;
                    if (themeConfig.hasAmount) theadHtml += `<th>${themeConfig.tabs[1]}<br><small>Amount</small></th>`;
                    colSpan = themeConfig.hasAmount ? 5 : 3;
                } else {
                    theadHtml += `<th>Count</th>`;
                    if (themeConfig.hasAmount) theadHtml += `<th>Amount</th>`;
                    colSpan = themeConfig.hasAmount ? 3 : 2;
                }
                theadHtml += `</tr>`;
                $card.find('thead').html(theadHtml);

                let tableRowsHtml = '';
                let grandCount1 = 0, grandAmt1 = 0, grandCount2 = 0, grandAmt2 = 0;

                const buildRow = (item, isSubtotal = false, labelOverride = null) => {
                    let html = '';
                    let label = labelOverride || item.label;

                    if (!isSubtotal) {
                        // Access the static server JSON object
                        const stats1 = (serverStatsData[item.value] || serverStatsData['default'])['tab1'];
                        const stats2 = (serverStatsData[item.value] || serverStatsData['default'])['tab2'];
                        
                        html += `<tr><td>${label}</td>`;
                        if (statusTab === 'tab3') {
                            html += `<td>${formatNumber(stats1.count)}</td>`;
                            if (themeConfig.hasAmount) html += `<td>${formatNumber(stats1.amount)}</td>`;
                            html += `<td>${formatNumber(stats2.count)}</td>`;
                            if (themeConfig.hasAmount) html += `<td>${formatNumber(stats2.amount)}</td>`;
                        } else {
                            const stats = (statusTab === 'tab1') ? stats1 : stats2;
                            html += `<td>${formatNumber(stats.count)}</td>`;
                            if (themeConfig.hasAmount) html += `<td>${formatNumber(stats.amount)}</td>`;
                        }
                        html += `</tr>`;
                        return { html, c1: stats1.count, a1: stats1.amount, c2: stats2.count, a2: stats2.amount };
                    } else {
                        html += `<tr class="subgroup-subtotal"><td>${label}</td>`;
                        if (statusTab === 'tab3') {
                            html += `<td>${formatNumber(item.c1)}</td>`;
                            if (themeConfig.hasAmount) html += `<td>${formatNumber(item.a1)}</td>`;
                            html += `<td>${formatNumber(item.c2)}</td>`;
                            if (themeConfig.hasAmount) html += `<td>${formatNumber(item.a2)}</td>`;
                        } else {
                            const c = (statusTab === 'tab1') ? item.c1 : item.c2;
                            const a = (statusTab === 'tab1') ? item.a1 : item.a2;
                            html += `<td>${formatNumber(c)}</td>`;
                            if (themeConfig.hasAmount) html += `<td>${formatNumber(a)}</td>`;
                        }
                        html += `</tr>`;
                        return html;
                    }
                };

                if (isSubgrouped) {
                    const subgroups = $card.data('subgroups');
                    subgroups.forEach(sub => {
                        tableRowsHtml += `<tr class="no-search"><td colspan="${colSpan}" class="fw-bold text-dark pt-3 pb-1 border-bottom-0" style="font-size: 0.8rem;">${sub.name}</td></tr>`;
                        let subC1 = 0, subA1 = 0, subC2 = 0, subA2 = 0;

                        sub.items.forEach(item => {
                            const rowData = buildRow(item);
                            tableRowsHtml += rowData.html;
                            subC1 += rowData.c1; subA1 += rowData.a1;
                            subC2 += rowData.c2; subA2 += rowData.a2;
                        });

                        tableRowsHtml += buildRow({ c1: subC1, a1: subA1, c2: subC2, a2: subA2 }, true, 'Total');
                        grandCount1 += subC1; grandAmt1 += subA1;
                        grandCount2 += subC2; grandAmt2 += subA2;
                    });
                } else {
                    const items = $card.data('items');
                    items.forEach(item => {
                        const rowData = buildRow(item);
                        tableRowsHtml += rowData.html;
                        grandCount1 += rowData.c1; grandAmt1 += rowData.a1;
                        grandCount2 += rowData.c2; grandAmt2 += rowData.a2;
                    });
                }

                $card.find('tbody').html(tableRowsHtml);

                let tfootHtml = `<tr><td>TOTAL</td>`;
                if (statusTab === 'tab3') {
                    tfootHtml += `<td>${formatNumber(grandCount1)}</td>`;
                    if (themeConfig.hasAmount) tfootHtml += `<td>${formatNumber(grandAmt1)}</td>`;
                    tfootHtml += `<td>${formatNumber(grandCount2)}</td>`;
                    if (themeConfig.hasAmount) tfootHtml += `<td>${formatNumber(grandAmt2)}</td>`;
                } else {
                    const finalCount = (statusTab === 'tab1') ? grandCount1 : grandCount2;
                    const finalAmt = (statusTab === 'tab1') ? grandAmt1 : grandAmt2;
                    tfootHtml += `<td>${formatNumber(finalCount)}</td>`;
                    if (themeConfig.hasAmount) tfootHtml += `<td>${formatNumber(finalAmt)}</td>`;
                }
                tfootHtml += `</tr>`;
                
                $card.find('tfoot').html(tfootHtml);

                applySearchHighlight();
            }


            // ==========================================
            // 7. GENERATE OVERVIEW & CARDS ON SUBMIT
            // ==========================================
            $('#btnSubmit').on('click', function() {
                const $overviewContainer = $('#moduleOverviewContainer');
                const $cardsContainer = $('#dashboardCardsContainer');
                
                $overviewContainer.empty();
                $cardsContainer.empty();
                $('#overviewHeader').addClass('d-none');
                $('#globalSearch').val(''); 

                let hasData = false;

                $('#dd-activity .group-container').each(function() {
                    const groupName = $(this).attr('data-group-name');
                    const groupValue = $(this).attr('data-group-value');
                    const hasSubgroups = $(this).find('.subgroup-container').length > 0;
                    const themeConfig = cardThemes[groupValue] || cardThemes['proposals'];
                    
                    let flatItems = [];
                    let subgroups = [];
                    let totalCheckedInGroup = 0;
                    
                    let groupTab1Count = 0; 
                    let groupTab2Count = 0;

                    if (hasSubgroups) {
                        $(this).find('.subgroup-container').each(function() {
                            const subName = $(this).find('.subgroup-checkbox').parent().text().trim();
                            const subItems = [];
                            $(this).find('.item-checkbox:checked').each(function() {
                                const val = $(this).val();
                                subItems.push({ value: val, label: $(this).parent().text().trim() });
                                groupTab1Count += (serverStatsData[val] || serverStatsData['default'])['tab1'].count;
                                groupTab2Count += (serverStatsData[val] || serverStatsData['default'])['tab2'].count;
                                totalCheckedInGroup++;
                            });
                            if (subItems.length > 0) subgroups.push({ name: subName, items: subItems });
                        });
                    } else {
                        $(this).find('.item-checkbox:checked').each(function() {
                            const val = $(this).val();
                            flatItems.push({ value: val, label: $(this).parent().text().trim() });
                            groupTab1Count += (serverStatsData[val] || serverStatsData['default'])['tab1'].count;
                            groupTab2Count += (serverStatsData[val] || serverStatsData['default'])['tab2'].count;
                            totalCheckedInGroup++;
                        });
                    }

                    if (totalCheckedInGroup > 0) {
                        hasData = true;
                        
                        const summaryCardHtml = `
                            <div class="col-xl-3 col-lg-4 col-md-6">
                                <div class="summary-card" data-target="detail-${groupValue}">
                                    <div class="summary-header">
                                        <div class="summary-icon bg-${themeConfig.baseColor}"><i class="bi ${themeConfig.icon}"></i></div>
                                        ${groupName}
                                    </div>
                                    <div class="summary-stats">
                                        <div class="stat-box">
                                            <span class="stat-value">${formatNumber(groupTab1Count)}</span>
                                            <span class="stat-label">Total ${themeConfig.tabs[0]}</span>
                                        </div>
                                        <div class="stat-box text-end">
                                            <span class="stat-value">${formatNumber(groupTab2Count)}</span>
                                            <span class="stat-label">${themeConfig.tabs[1]}</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        `;
                        $overviewContainer.append(summaryCardHtml);

                        const $cardWrapper = $(`<div class="col-xl-4 col-lg-6 detail-card-wrapper" id="detail-${groupValue}"></div>`);
                        const $card = $(`
                            <div class="dash-card ${themeConfig.themeClass}">
                                <div class="dash-card-header">
                                    <div class="header-title-wrap"><i class="bi ${themeConfig.icon}"></i> ${groupName}</div>
                                    <i class="bi bi-dash card-minus-btn hide-detail-btn" title="Hide Card"></i>
                                </div>
                                <div class="dash-toggle-container">
                                    <button class="dash-toggle-btn active" data-status="tab1">${themeConfig.tabs[0]}</button>
                                    <button class="dash-toggle-btn" data-status="tab2">${themeConfig.tabs[1]}</button>
                                    <button class="dash-toggle-btn border-start" data-status="tab3">Both</button>
                                </div>
                                <div class="dash-table-wrapper">
                                    <table class="dash-table">
                                        <thead></thead>
                                        <tbody></tbody>
                                        <tfoot></tfoot>
                                    </table>
                                </div>
                            </div>
                        `);

                        $card.data('groupVal', groupValue);
                        $card.data('isSubgrouped', hasSubgroups);
                        if (hasSubgroups) $card.data('subgroups', subgroups);
                        else $card.data('items', flatItems);

                        renderCardTable($card, 'tab1');
                        
                        $cardWrapper.append($card);
                        $cardsContainer.append($cardWrapper);
                    }
                });

                if (hasData) {
                    $('#overviewHeader').removeClass('d-none');
                } else {
                    $overviewContainer.html(`<div class="col-12 text-center text-danger mt-2">Please select options from the Activity dropdown to view data.</div>`);
                }
            });

            // ==========================================
            // 8. INTERACTIONS (Toggles & Hide)
            // ==========================================
            
            $(document).on('click', '.dash-toggle-btn', function() {
                const $btn = $(this); const $card = $btn.closest('.dash-card');
                $card.find('.dash-toggle-btn').removeClass('active');
                $btn.addClass('active');
                renderCardTable($card, $btn.data('status'));
            });

            $(document).on('click', '.hide-detail-btn', function() {
                $(this).closest('.detail-card-wrapper').fadeOut(200);
            });

            $(document).on('click', '.summary-card', function() {
                const targetId = $(this).data('target');
                const $targetCard = $('#' + targetId);
                
                if ($targetCard.is(':visible')) {
                    $targetCard.fadeOut(200);
                } else {
                    $targetCard.fadeIn(200);
                    $('html, body').animate({ scrollTop: $targetCard.offset().top - 20 }, 300);
                }
            });

        });
    </script>
</body>
</html>




