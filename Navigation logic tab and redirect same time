    <script>
        document.addEventListener('DOMContentLoaded', function() {
            
            // --- Simulation Setup ---
            // For this demonstration, we will simulate the current URL.
            // In your actual application, you would use window.location.pathname
            let simulatedCurrentPage = 'llmsInsightModuleLevel.html';
            const pageTitleEl = document.getElementById('page-title');
            const outputEl = document.getElementById('page-logic-output');
            
            // Helper to update the UI for the simulation
            function updateSimulationUI(page, activeTarget) {
                pageTitleEl.textContent = `Current Page: ${page} (Simulated)`;
                
                // Update active tab styling
                document.querySelectorAll('.nav-link').forEach(link => link.classList.remove('active'));
                if (page === 'llmsInsightModuleLevel.html') {
                    document.getElementById('link-module-level').classList.add('active');
                } else if (activeTarget) {
                    const activeLink = document.querySelector(`.level-btn[data-target="${activeTarget}"]`);
                    if (activeLink) activeLink.classList.add('active');
                }
            }

            // Function representing the logic to run on the branch level page
            function executeBranchLevelLogic(levelData, targetName) {
                console.log(`Executing logic for level ${levelData} (${targetName}) on llmsInsightBranchLevel.html`);
                outputEl.innerHTML = `<span class="text-success">Executing logic for <strong>${targetName}</strong> (Level: ${levelData}). Updating UI components...</span>`;
                
                // Here you would put your actual logic:
                // - Show/hide specific dropdowns (Business Group, Circle, etc. as seen in the first image)
                // - Fetch data for the specific level
                // - Update charts/tables
            }


            // --- Actual Navigation Logic ---
            
            const levelButtons = document.querySelectorAll('.level-btn');
            const targetPage = 'llmsInsightBranchLevel.html';

            // 1. Handle "Module Level" click (First link)
            document.getElementById('link-module-level').addEventListener('click', function(e) {
                e.preventDefault();
                // In reality: window.location.href = 'llmsInsightModuleLevel.html';
                
                // Simulation
                simulatedCurrentPage = 'llmsInsightModuleLevel.html';
                updateSimulationUI(simulatedCurrentPage, null);
                outputEl.textContent = "Redirected to Module Level page.";
                console.log("Redirecting to: llmsInsightModuleLevel.html");
            });

            // 2. Handle "Circle, Network, Module, RBO, Branch" clicks
            levelButtons.forEach(button => {
                button.addEventListener('click', function(e) {
                    e.preventDefault(); // Prevent default anchor behavior
                    
                    const level = this.getAttribute('data-level');
                    const target = this.getAttribute('data-target');
                    
                    // In your real application, check the actual URL:
                    // const currentPage = window.location.pathname.split('/').pop(); 
                    
                    // Using simulated page for this demo
                    const currentPage = simulatedCurrentPage;

                    if (currentPage === targetPage) {
                        // WE ARE ALREADY ON THE TARGET PAGE
                        console.log(`Already on ${targetPage}. Triggering logic for ${target} without redirect.`);
                        
                        // Update active state visually immediately
                        document.querySelectorAll('.nav-link').forEach(link => link.classList.remove('active'));
                        this.classList.add('active');
                        
                        // Execute the specific logic for this tab
                        executeBranchLevelLogic(level, target);

                    } else {
                        // WE ARE ON A DIFFERENT PAGE (e.g., Module Level page)
                        console.log(`Not on ${targetPage}. Redirecting...`);
                        
                        // You need a way to tell the next page which tab was clicked.
                        // URL parameters are best for this.
                        const redirectUrl = `${targetPage}?activeTab=${target}&level=${level}`;
                        
                        // In reality: window.location.href = redirectUrl;
                        
                        // Simulation of redirect and subsequent page load:
                        outputEl.innerHTML = `<span class="text-primary">Redirecting to: ${redirectUrl}...</span>`;
                        setTimeout(() => {
                            simulatedCurrentPage = targetPage;
                            updateSimulationUI(simulatedCurrentPage, target);
                            
                            // Simulate what happens when the page loads
                            // (This logic would actually be in an IIFE or DOMContentLoaded on llmsInsightBranchLevel.html)
                            simulatePageLoadLogic(target, level);
                        }, 800); 
                    }
                });
            });

            // --- Logic that would run on load of llmsInsightBranchLevel.html ---
            function simulatePageLoadLogic(target, level) {
                console.log(`Page loaded: ${targetPage}`);
                // In reality, you would parse the URL parameters here:
                // const urlParams = new URLSearchParams(window.location.search);
                // const activeTab = urlParams.get('activeTab');
                // const levelVal = urlParams.get('level');
                
                // if (activeTab) {
                //      executeBranchLevelLogic(levelVal, activeTab);
                //      // also set the active class on the correct tab based on activeTab
                // } else {
                //      // Default behavior if accessed directly without params
                // }
                
                outputEl.innerHTML += `<br><span class="text-success mt-2 d-block">Page loaded. Extracted params: target=${target}. Executing logic...</span>`;
                executeBranchLevelLogic(level, target);
            }
        });
    </script>
