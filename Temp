

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Financial Review Sections</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: #f3f3f5;
      padding: 32px;
      color: #2c2c2e;
    }

    .container {
      max-width: 960px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    /* Section Card */
    .section-card {
      background-color: #fafafa;
      border: 1px solid #d8d8dc;
      border-radius: 2px;
      overflow: hidden;
    }

    /* Purple Header Bar */
    .section-header {
      background-color: #463759;
      color: #ffffff;
      padding: 10px 16px;
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 13.5px;
      font-weight: 600;
    }

    .header-title {
      letter-spacing: 0.01em;
    }

    /* Badges inside Header */
    .tag {
      font-size: 11px;
      font-weight: 700;
      padding: 2px 7px;
      border-radius: 3px;
      display: inline-flex;
      align-items: center;
    }

    .tag-medium {
      background-color: #d99b26;
      color: #1f1705;
    }

    .tag-change {
      background-color: #d99b26;
      color: #1f1705;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }

    /* Header Icons */
    .header-icons {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: #b5acc4;
      margin-left: 2px;
    }

    .header-icons svg {
      width: 14px;
      height: 14px;
      stroke: currentColor;
      stroke-width: 1.8;
      fill: none;
      cursor: pointer;
    }

    .header-icons svg:hover {
      color: #ffffff;
    }

    /* Subtitle / Prompt Guide */
    .section-subtitle {
      padding: 10px 16px;
      font-size: 12.5px;
      color: #78787c;
      border-bottom: 1px solid #e4e4e8;
      background-color: #f7f7f9;
    }

    /* Content Area */
    .section-body {
      padding: 14px 16px 16px;
    }

    /* Tracked Changes Box */
    .tracked-changes-box {
      border: 1.5px solid #4a55a2;
      background-color: #ffffff;
      padding: 12px 16px 18px;
    }

    /* Action Buttons Row (Accept / Reject / Modify) */
    .review-actions {
      display: flex;
      justify-content: flex-end;
      align-items: center;
      gap: 6px;
      margin-bottom: 12px;
    }

    .btn-action {
      font-size: 12.5px;
      font-weight: 500;
      padding: 5px 12px;
      border-radius: 4px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      border: 1px solid transparent;
      background: transparent;
      color: #3a3a3c;
    }

    .btn-accept {
      background-color: #3b2a54;
      color: #ffffff;
    }

    .btn-accept:hover {
      background-color: #4d386d;
    }

    .btn-reject:hover,
    .btn-modify:hover {
      background-color: #f0f0f4;
    }

    /* Diff / Serif Text Content */
    .serif-content {
      font-family: Georgia, "Times New Roman", Times, serif;
      font-size: 14px;
      line-height: 1.65;
      color: #2c2c2e;
    }

    .diff-deleted {
      color: #b33939;
      text-decoration: line-through;
      background-color: #fdf0f0;
    }

    .diff-added {
      color: #1e6b3b;
      text-decoration: underline;
      background-color: #eef8f1;
    }

    /* Footer Links inside Card */
    .card-footer-left {
      margin-top: 12px;
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 12.5px;
      color: #6c6c70;
      cursor: pointer;
    }

    .card-footer-left:hover {
      color: #2c2c2e;
    }

    .card-footer-right {
      margin-top: 14px;
      display: flex;
      justify-content: flex-end;
      align-items: center;
      gap: 6px;
      font-size: 12.5px;
      color: #5a5a5e;
      cursor: pointer;
    }

    .card-footer-right:hover {
      color: #1c1c1e;
    }

    .editor-box {
      background-color: #ffffff;
      border: 1px solid #e2e2e6;
      padding: 16px;
    }

    .icon-sm {
      width: 14px;
      height: 14px;
      stroke: currentColor;
      stroke-width: 1.8;
      fill: none;
    }
  </style>
</head>
