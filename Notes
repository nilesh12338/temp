$(document).on('click', 'a[href*=".do"]:not(.no-loader)', function () {
    const href = $(this).attr('href');

    if (/\.do(\?|$)/.test(href) &&
        !/^javascript:/i.test(href) &&
        !/\(.*\)/.test(href)) {

        showDataLoader();
    }
